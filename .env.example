# Local demo values for docker compose. Copy to .env (git-ignored): cp .env.example .env
# Never reuse these values in a shared or public environment.
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
JWT_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_SECRET_32PLUS

# Demo-only switches: creates admin / Admin123! and exposes Swagger UI.
SEED_DEFAULT_ADMIN=true
SWAGGER_ENABLED=true
